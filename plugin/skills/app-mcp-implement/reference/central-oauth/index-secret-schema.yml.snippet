# Merge into index.yml and substitute <camel>. Values are written only by the
# maintainer SPA through setOAuthClient; no provider default belongs here.
config:
  value:
    centralAuth: '{{secret.<camel>CentralOAuth}}'

secrets:
  schema:
    <camel>CentralOAuth:
      type: object
      title: Central OAuth client and provider configuration
      properties:
        oauthClientId:
          type: string
        oauthClientSecret:
          type: string
        scopes:
          type: string
        authorizeUrl:
          type: string
        tokenUrl:
          type: string
      required:
        - oauthClientId
        - oauthClientSecret
        - scopes
        - authorizeUrl
        - tokenUrl
      ui:widget: password
