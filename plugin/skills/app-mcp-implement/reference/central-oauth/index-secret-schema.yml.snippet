# Merge into index.yml and substitute <camel>. Values are written only by the
# maintainer SPA through setOAuthClient; no provider default belongs here.
# One secret key = one plain value — never an aggregate client object.
config:
  value:
    centralOAuthClientId: '{{secret.<camel>CentralOAuthClientId}}'
    centralOAuthClientSecret: '{{secret.<camel>CentralOAuthClientSecret}}'
    centralOAuthScopes: '{{secret.<camel>CentralOAuthScopes}}'
    centralOAuthAuthorizeUrl: '{{secret.<camel>CentralOAuthAuthorizeUrl}}'
    centralOAuthTokenUrl: '{{secret.<camel>CentralOAuthTokenUrl}}'

secrets:
  schema:
    <camel>CentralOAuthClientId:
      type: string
      title: Central OAuth client id
      ui:widget: password
    <camel>CentralOAuthClientSecret:
      type: string
      title: Central OAuth client secret
      ui:widget: password
    <camel>CentralOAuthScopes:
      type: string
      title: Central OAuth scopes
      ui:widget: password
    <camel>CentralOAuthAuthorizeUrl:
      type: string
      title: Central OAuth authorize URL
      ui:widget: password
    <camel>CentralOAuthTokenUrl:
      type: string
      title: Central OAuth token URL
      ui:widget: password
